{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bapp Gym Coach",
  "version": "0.1.0",
  "identifier": "com.bapp.gymcoach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bapp Gym Coach",
        "width": 1600,
        "height": 960,
        "minWidth": 1366,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/bapp-api"
    ]
  }
}
